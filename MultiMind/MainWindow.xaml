<Window x:Class="MultiMind.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MultiMind AI Portable" Height="720" Width="1040" MinHeight="560" MinWidth="760" WindowStartupLocation="CenterScreen" Background="#0B1020">
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="MultiMind AI" Foreground="White" FontSize="30" FontWeight="Bold"/><TextBlock Text="Portable Windows App mit automatischem Modell-Fallback" Foreground="#AAB4D1" Margin="0,4,0,16"/>
<StackPanel Orientation="Horizontal"><TextBlock Text="Backend:" Foreground="White" VerticalAlignment="Center"/><TextBox x:Name="BackendBox" Width="430" Margin="10,0" Text="http://localhost:8000/" Padding="8"/><Button Content="Modelle laden" Click="LoadModels_Click" Padding="14,8"/><ComboBox x:Name="ModelBox" Width="210" Margin="10,0,0,0"/></StackPanel></StackPanel>
<Border Grid.Row="1" Background="#121A30" CornerRadius="14" Margin="0,18" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="AnswerText" Text="Stelle deine erste Frage." Foreground="White" FontSize="16" TextWrapping="Wrap"/></ScrollViewer></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBox x:Name="PromptBox" AcceptsReturn="True" MinHeight="82" TextWrapping="Wrap" Padding="10"/><TextBlock x:Name="StatusText" Text="Bereit" Foreground="#AAB4D1" Margin="2,7,0,0"/></StackPanel><Button x:Name="SendButton" Grid.Column="1" Content="Senden" Click="Send_Click" Margin="14,0,0,0" Padding="28,12" VerticalAlignment="Top" Background="#5865F2" Foreground="White"/></Grid></Grid></Window>
